# Django Settings
# Generate a secret key using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For local development (venv) - Use SQLite by default (no installation needed)
USE_SQLITE=True

# If you want to use MariaDB for local testing, set USE_SQLITE=False and configure:
# USE_SQLITE=False
# DB_NAME=news_db
# DB_USER=news_user
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306

# For Docker (use these values):
# USE_SQLITE=False
# DB_NAME=news_db
# DB_USER=news_user
# DB_PASSWORD=news_password
# DB_HOST=db
# DB_PORT=3306

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@newsapp.com

# Twitter API Configuration (optional)
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-access-token-secret
TWITTER_BEARER_TOKEN=your-bearer-token

# Logging Configuration (optional)
# Set to True to enable file logging, False for console-only
ENABLE_FILE_LOGGING=False
# Path to logs directory (only needed if ENABLE_FILE_LOGGING=True)
LOGS_DIR=
